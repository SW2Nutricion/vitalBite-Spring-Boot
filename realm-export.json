{
  "realm": "vitalbite",
  "enabled": true,
  "displayName": "VitalBite",
  "clients": [
    {
      "clientId": "vitalbite-documental",
      "name": "VitalBite Documental",
      "enabled": true,
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "protocol": "openid-connect",
      "defaultClientScopes": ["profile", "email", "roles", "web-origins", "audience-documental", "tenant"]
    }
  ],
  "clientScopes": [
    {
      "name": "audience-documental",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "documental audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {"included.client.audience": "vitalbite-documental", "access.token.claim": "true"}
        }
      ]
    },
    {
      "name": "tenant",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "tenant_id",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {"user.attribute": "tenant_id", "claim.name": "tenant_id", "jsonType.label": "String", "access.token.claim": "true", "id.token.claim": "true"}
        }
      ]
    }
  ],
  "roles": {
    "realm": [
      {"name": "ADMIN"}, {"name": "NUTRICIONISTA"}, {"name": "PACIENTE"}, {"name": "SERVICE"}
    ]
  },
  "users": [
    {"username": "admin", "enabled": true, "id": "00000000-0000-0000-0000-000000000001", "credentials": [{"type": "password", "value": "admin", "temporary": false}], "realmRoles": ["ADMIN"], "attributes": {"tenant_id": "clinica-central"}},
    {"username": "nutricionista", "enabled": true, "id": "00000000-0000-0000-0000-000000000002", "credentials": [{"type": "password", "value": "nutricionista", "temporary": false}], "realmRoles": ["NUTRICIONISTA"], "attributes": {"tenant_id": "clinica-central"}},
    {"username": "paciente-central", "enabled": true, "id": "00000000-0000-0000-0000-000000000003", "credentials": [{"type": "password", "value": "paciente", "temporary": false}], "realmRoles": ["PACIENTE"], "attributes": {"tenant_id": "clinica-central"}},
    {"username": "paciente-norte", "enabled": true, "id": "00000000-0000-0000-0000-000000000004", "credentials": [{"type": "password", "value": "paciente", "temporary": false}], "realmRoles": ["PACIENTE"], "attributes": {"tenant_id": "clinica-norte"}}
  ]
}
