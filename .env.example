# ===================================================================
# ARCHIVO DE VARIABLES DE ENTORNO (.env)
# Copia este archivo como .env y completa los valores reales
# IMPORTANTE: NUNCA commitsear este archivo al repositorio
# ===================================================================

# ===================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ===================================================================
# Para desarrollo local (puede ser 8082 o el puerto que prefieras)
SERVER_PORT=8082

SPRING_PROFILES_ACTIVE=local
LOG_LEVEL=INFO

POSTGRES_DB=vitalbite
POSTGRES_USER=vitalbite
POSTGRES_PASSWORD=vitalbite
POSTGRES_PORT=5432

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_PORT=8080
KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/vitalbite

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
