# ===================================================================
# ARCHIVO DE VARIABLES DE ENTORNO (.env)
# Copia este archivo como .env y completa los valores reales
# IMPORTANTE: NUNCA commitsear este archivo al repositorio
# ===================================================================

# ===================================================================
# CONFIGURACIÓN DEL SERVIDOR
# ===================================================================
# Para desarrollo local (puede ser 8082 o el puerto que prefieras)
SERVER_PORT=8082

# Para producción
SPRING_PROFILES_ACTIVE=production
LOG_LEVEL=INFO
